# ChainLens - Environment Variables
# Copy this file to .env and fill in your keys

# ============================================
# REQUIRED API KEYS
# ============================================

# 1. Tatum API Key (Starts with "t-")
# Get from https://tatum.io/
TATUM_API_KEY=your_tatum_api_key_here

# 2. Google Gemini AI API Key (Starts with "AIza")
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# SERVER CONFIGURATION
# ============================================

PORT=3000

# ============================================
# ENVIO HYPERSYNC (Required for Agent)
# ============================================
# Critical for "Best Use of Envio" track
# Leave empty to use Public Sepolia Endpoint (Limited Rate)
# Or get token for production: https://envio.dev/
ENVIO_API_TOKEN=

# ============================================
# AGENT RELAYER (Required for Real Execution)
# ============================================
# Private key for the backend to execute trades on Sepolia
# ⚠️ Use a TESTNET wallet with small ETH (~0.01 ETH)
# Format: 0x... (64 hex characters)
AGENT_PRIVATE_KEY=

# ============================================
# OPTIONAL: TELEGRAM BOT
# ============================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Public base URL of your web server (used by Telegram bot)
WEB_SERVER_URL=http://localhost:3000
